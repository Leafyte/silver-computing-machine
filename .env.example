# ==============================================================================
# DebugLeaf Environment Configuration Template (.env.example)
#
# Copy this file to .env and populate the required values:
#   cp .env.example .env
#
# SECURITY NOTE:
#   Never commit the actual .env file or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. QpiAI Platform & Cloud Credentials
# ------------------------------------------------------------------------------
# Obtain your free API key by registering at: https://opt.qpiai.tech
QPIAI_OPT_API_KEY=your_qpiai_opt_api_key_here

# API key for QpiAI Quantum Cloud (QCloud) and remote QPU / cloud simulator access
QPIAI_QCLOUD_API_KEY=your_qpiai_qcloud_api_key_here


# ------------------------------------------------------------------------------
# 2. DebugLeaf API & Authentication Settings
# ------------------------------------------------------------------------------
# Authentication mode:
#   - "local": Default unauthenticated mode for local development and testing
#   - "token": Enforces Bearer token authorization across dispatcher, researcher, and admin roles
DEBUGLEAF_AUTH_MODE=local

# Role-based bearer tokens (required ONLY if DEBUGLEAF_AUTH_MODE=token; must all be distinct)
DEBUGLEAF_DISPATCHER_TOKEN=debugleaf-dispatcher-secret-token
DEBUGLEAF_RESEARCHER_TOKEN=debugleaf-researcher-secret-token
DEBUGLEAF_ADMIN_TOKEN=debugleaf-admin-secret-token

# One-time mobile pairing codes. Replace the example values and keep this JSON
# server-side only; each code binds one driver to one vehicle and is redeemed once.
DEBUGLEAF_DRIVER_PAIRING_CODES=[]
DEBUGLEAF_DRIVER_DB_PATH=.runtime/drivers.sqlite3

# Browser origins allowed to call the local API. Override with exact origins
# for deployments; do not use a wildcard with authenticated browser requests.
DEBUGLEAF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# ------------------------------------------------------------------------------
# 3. Server & Storage Configuration
# ------------------------------------------------------------------------------
# Local SQLite database path for persistent async job lifecycles and audit trails
DEBUGLEAF_DB_PATH=.runtime/debugleaf.sqlite3

# Local SQLite database path for India ETA workflow jobs and recovery
DEBUGLEAF_ETA_DB_PATH=.runtime/india_eta.sqlite3

# API server host and port
DEBUGLEAF_HOST=127.0.0.1
DEBUGLEAF_PORT=8000


# ------------------------------------------------------------------------------
# 4. Quantum & Simulator Runtime Defaults
# ------------------------------------------------------------------------------
# Default VQC execution backend:
#   - "reference": Pure-Python exact statevector simulator (zero external dependency)
#   - "qpiai_local": QpiAI Quantum local StatevectorSimulator (requires qpiai-quantum)
DEFAULT_EXECUTION_BACKEND=qpiai_local

# Default random seed for deterministic sampling and benchmarks
RANDOM_SEED=42
