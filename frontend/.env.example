# Copy to .env.local and adjust. All values are optional.

# API base URL used by the browser. Leave empty to call the same origin;
# the Vite dev/preview server proxies /api to VITE_PROXY_TARGET because the
# backend has no CORS middleware. Only set an absolute URL if that origin
# serves the frontend or allows CORS.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_TIMEOUT_MS=30000

# Map tiles. Leave empty to disable the map (coordinate editor fallback).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional OSRM-compatible routing service for road geometry, e.g.
# https://router.project-osrm.org . Leave empty for straight-line stop order.
VITE_ROUTING_URL=

# Initial map view for new drafts: "lat,lng,zoom".
VITE_MAP_DEFAULT_VIEW=20,0,2

